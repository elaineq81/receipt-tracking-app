    "NSCameraUsageDescription": {
      "comment": "Explains why ReceiptSure requests camera access.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure verwendet die Kamera, um Belege zu scannen, zu erkennen und zuzuschneiden, die du speichern möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure uses the camera to scan, detect, and crop receipts you choose to save."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure usa la cámara para escanear, detectar y recortar los recibos que decidas guardar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure usa la cámara para escanear, detectar y recortar los recibos que decidas guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure utilise l’appareil photo pour numériser, détecter et recadrer les reçus que vous choisissez d’enregistrer."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure utilise l’appareil photo pour numériser, détecter et recadrer les reçus que vous choisissez d’enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSureは、保存するレシートのスキャン、検出、切り抜きにカメラを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure는 저장할 영수증을 스캔하고 감지하며 자르기 위해 카메라를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ReceiptSure usa a câmera para digitalizar, detectar e recortar os recibos que você escolher salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ReceiptSure utiliza a câmara para digitalizar, detetar e recortar os recibos que optar por guardar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure 使用相机扫描、检测并裁剪你选择保存的收据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure 使用相機掃描、偵測並裁切你選擇儲存的收據。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Explains why ReceiptSure requests Face ID authentication.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure verwendet Face ID, um deine lokal gespeicherten Belege und Ausgabendaten zu schützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure uses Face ID to protect your locally stored receipts and expense records."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure usa Face ID para proteger los recibos y registros de gastos almacenados localmente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure usa Face ID para proteger los recibos y registros de gastos almacenados localmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure utilise Face ID pour protéger vos reçus et relevés de dépenses stockés localement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure utilise Face ID pour protéger vos reçus et relevés de dépenses stockés localement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSureは、端末内に保存されたレシートと支出記録を保護するためにFace IDを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure는 기기에 저장된 영수증과 지출 기록을 보호하기 위해 Face ID를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ReceiptSure usa o Face ID para proteger seus recibos e registros de despesas armazenados localmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ReceiptSure utiliza o Face ID para proteger os recibos e registos de despesas guardados localmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure 使用 Face ID 保护存储在本机的收据和支出记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure 使用 Face ID 保護儲存在本機的收據和支出記錄。"
          }
        }
      }
    },
