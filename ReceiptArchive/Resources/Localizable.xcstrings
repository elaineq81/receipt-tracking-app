    "Receipt images and expense details stay local unless you explicitly enable private iCloud sync.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى صور الإيصالات وتفاصيل النفقات على الجهاز ما لم تفعّل مزامنة iCloud الخاصة صراحةً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegbilder und Ausgabendetails bleiben auf diesem Gerät, sofern du die private iCloud-Synchronisierung nicht ausdrücklich aktivierst."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes de recibos y los detalles de gastos permanecen en el dispositivo, salvo que actives expresamente la sincronización privada con iCloud."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes de recibos y los detalles de gastos permanecen en el dispositivo, salvo que actives expresamente la sincronización privada con iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images des reçus et les détails des dépenses restent sur l’appareil, sauf si vous activez explicitement la synchronisation iCloud privée."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images des reçus et les détails des dépenses restent sur l’appareil, sauf si vous activez explicitement la synchronisation iCloud privée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות הקבלות ופרטי ההוצאות נשארים במכשיר, אלא אם מפעילים במפורש סנכרון iCloud פרטי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシート画像と支出の詳細は、プライベートiCloud同期を明示的に有効にしない限り、このデバイスに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증 이미지와 지출 세부 정보는 비공개 iCloud 동기화를 직접 켜지 않는 한 이 기기에만 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens dos recibos e os detalhes das despesas ficam no dispositivo, a menos que você ative explicitamente a sincronização privada do iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens dos recibos e os detalhes das despesas ficam no dispositivo, a menos que ative explicitamente a sincronização privada do iCloud."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رسید کی تصاویر اور اخراجات کی تفصیلات اسی ڈیوائس پر رہتی ہیں، جب تک آپ نجی iCloud مطابقت پذیری واضح طور پر فعال نہ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收据图像和支出详情会保留在此设备上，除非你明确启用专用 iCloud 同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收據影像和支出詳情會保留在此裝置上，除非你明確啟用私人 iCloud 同步。"
          }
        }
      }
    },
