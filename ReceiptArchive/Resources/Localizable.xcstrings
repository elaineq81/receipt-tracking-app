    "Only receipts with a complete rate, effective date, and source are included.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur Quittungen mit einer vollständigen Rate, einem effektiven Datum und einer Quelle sind enthalten."
