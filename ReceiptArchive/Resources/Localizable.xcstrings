        }
      }
    },
    "The system file picker grants temporary access only to the image or PDF you select. Imported pages are stored inside the app’s private local database.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Systemdatei-Picker gewährt nur vorübergehenden Zugriff auf das Bild oderPDFSie wählen. Importierte Seiten werden in der privaten lokalen Datenbank der App gespeichert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El buscador de archivos del sistema otorga acceso temporal sólo a la imagen o PDF que seleccione. Las páginas importadas se almacenan dentro de la base de datos local privada de la aplicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El buscador de archivos del sistema otorga acceso temporal sólo a la imagen o PDF que seleccione. Las páginas importadas se almacenan dentro de la base de datos local privada de la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sélectionneur de fichiers système accorde un accès temporaire seulement à l'image ouPDFvous choisissez. Les pages importées sont stockées dans la base de données locale privée de l'application."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sélectionneur de fichiers système accorde un accès temporaire seulement à l'image ouPDFvous choisissez. Les pages importées sont stockées dans la base de données locale privée de l'application."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "システムファイルピッカーは、画像のみの一時的なアクセスを許可します。PDF選択します。 インポートされたページは、アプリのローカルデータベース内に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 파일 픽업자는 이미지 또는에만 임시 액세스를 부여합니다.PDF당신은 선택합니다. 가져온 페이지는 앱의 개인 로컬 데이터베이스에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O coletor de arquivos do sistema concede acesso temporário apenas à imagem ouPDFvocê seleciona. Páginas importadas são armazenadas dentro do banco de dados local privado do aplicativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O coletor de arquivos do sistema concede acesso temporário apenas à imagem ouPDFvocê seleciona. Páginas importadas são armazenadas dentro do banco de dados local privado do aplicativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系统文件拾取器只允许临时访问图像或PDF你选择。 导入的页面存储在应用程序的本地私人数据库中 。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系統檔案拾取器只允許暫時存取影像或PDF你選擇。 匯入的頁面被儲存在應用程式的私人本地資料庫中。"
          }
        }
      }
    },
    "The system photo picker can import only the images you select; the app does not request broad photo library access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Systemfoto-Picker kann nur die von Ihnen ausgewählten Bilder importieren; die App fordert keinen breiten Zugriff auf die Fotobibliothek an."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El selector de fotos del sistema puede importar sólo las imágenes que seleccione; la aplicación no solicita acceso amplio a la biblioteca de fotos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El selector de fotos del sistema puede importar sólo las imágenes que seleccione; la aplicación no solicita acceso amplio a la biblioteca de fotos."
