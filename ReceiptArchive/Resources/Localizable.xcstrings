    "Includes receipt images, OCR data, matters, revisions, financial provenance, merchant rules, and custom categories.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تشمل صور الاستلامOCRالبيانات، والمسائل، والتنقيحات، والثبات المالي، وقواعد التجار، وفئات العرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enthält Quittungsbilder,OCRDaten, Angelegenheiten, Revisionen, finanzielle Herkunft, Händlerregeln und benutzerdefinierte Kategorien."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye imágenes de recibos, datos de OCR, asuntos, revisiones, procedencia financiera, reglas de comercios y categorías personalizadas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye imágenes de recibos, datos de OCR, asuntos, revisiones, procedencia financiera, reglas de comercios y categorías personalizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprend les images de réception,OCRles données, les questions, les révisions, la provenance financière, les règles commerciales et les catégories douanières."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprend les images de réception,OCRles données, les questions, les révisions, la provenance financière, les règles commerciales et les catégories douanières."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כולל תמונות קבלה,OCRנתונים, נושאים, תיקונים, הוכחה פיננסית, כללי סוחר וקטגוריות מותאמות אישית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "領収書のイメージを含んで下さい、OCRデータ、問題、修正、財務の実績、商取引規則、およびカスタムカテゴリ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "영수증 이미지를 포함합니다,OCR데이터, 문제, 개정, 금융 검증, 상인 규칙 및 사용자 정의 카테고리."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inclui imagens de recibo,OCRdados, questões, revisões, procedência financeira, regras comerciais e categorias personalizadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inclui imagens de recibo,OCRdados, questões, revisões, procedência financeira, regras comerciais e categorias personalizadas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جن میں تصاویر شامل ہیں۔OCRاعداد ، معاملات ، ترمیم ، مالی ثبوت ، تاجروں کے قوانین اور دستور کی اقسام ۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "包括接收图像,OCR数据、事项、修订、财务来源、商法和习惯类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
