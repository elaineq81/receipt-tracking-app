    "Exports leave the app only when you choose a destination in Apple’s share sheet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فالصادرات لا تترك التطبيق إلا عندما تختار مقصدا في صحيفة آبل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exporte verlassen die App nur, wenn Sie ein Ziel in Apples Aktienblatt auswählen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos solo salen de la app cuando eliges un destino en la hoja para compartir de Apple."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos solo salen de la app cuando eliges un destino en la hoja para compartir de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les exportations ne quittent l'application que lorsque vous choisissez une destination dans la feuille de partage d'Apple."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les exportations ne quittent l'application que lorsque vous choisissez une destination dans la feuille de partage d'Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יצוא עוזב את האפליקציה רק כאשר אתה בוחר יעד ב-Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エクスポートは、Appleのシェアシートで目的地を選択したときにのみアプリを残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple의 공유 시트에서 목적지를 선택할 때만 앱을 남깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As exportações só saem do aplicativo quando você escolhe um destino na folha de ações da Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As exportações só saem do aplicativo quando você escolhe um destino na folha de ações da Apple."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برآمدات صرف ایپل کے شیئر شیٹ میں کسی منزل کا انتخاب کرتے وقت ایپ چھوڑ دیتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输出只在您在 Apple 的股单中选择目的地时才会离开应用程序 。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "出口只當您在 Apple 的 股單中選擇目的地時, 才離開應用程式 。"
          }
        }
