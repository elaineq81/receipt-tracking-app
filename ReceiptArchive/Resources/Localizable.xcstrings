    "Optional device authentication uses Face ID, Touch ID, or the device passcode. Privacy shielding hides receipt content when the app is not active.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwendung der optionalen GeräteauthentifizierungFace IDTouch ID oder den Device Passcode. Privacy Shielding verbirgt Empfangsinhalte, wenn die App nicht aktiv ist."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La autenticación del dispositivo opcional utiliza Face ID, Touch ID o el contraseña del dispositivo. Protección de privacidad oculta el contenido de recibo cuando la aplicación no está activa."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La autenticación del dispositivo opcional utiliza Face ID, Touch ID o el contraseña del dispositivo. Protección de privacidad oculta el contenido de recibo cuando la aplicación no está activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisations optionnelles d'authentification des appareilsFace ID, Touch ID, ou le code d'accès de l'appareil. Protection de la vie privée masque le contenu de la réception lorsque l'application n'est pas active."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisations optionnelles d'authentification des appareilsFace ID, Touch ID, ou le code d'accès de l'appareil. Protection de la vie privée masque le contenu de la réception lorsque l'application n'est pas active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任意装置認証の使用Face ID、接触ID、または装置パスコード。 プライバシーシールドは、アプリがアクティブでないときにレシートコンテンツを隠します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "옵션 장치 인증 사용Face ID, 접촉 ID, 또는 장치 암호. Privacy Shielding는 앱이 활성화되지 않을 때 영수증 콘텐츠를 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usos de autenticação opcional do dispositivoFace ID, Touch ID, ou a senha do dispositivo. Proteção de privacidade esconde conteúdo de recibo quando o aplicativo não está ativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usos de autenticação opcional do dispositivoFace ID, Touch ID, ou a senha do dispositivo. Proteção de privacidade esconde conteúdo de recibo quando o aplicativo não está ativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可选设备认证用途Face ID触摸ID或设备密码 隐私屏蔽在应用程序不活动时隐藏接收内容."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可選擇的裝置認證用途Face ID觸摸ID或裝置密碼 隱私屏蔽隱藏應用程式未啟動時的收件內容 。"
          }
        }
      }
    },
    "Optional notes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fakultative Anmerkungen"
          }
