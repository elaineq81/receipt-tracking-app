    "ReceiptSure includes no developer account, analytics, advertising, or tracking. The developer does not receive your private iCloud content.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSureولا يشمل أي حساب للمطورين أو محللين أو إعلانات أو تتبع. المطور لا يتلقى خاصتكiCloudالمحتوى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSureenthält kein Entwicklerkonto, Analyse, Werbung oder Tracking. Der Entwickler erhält nicht Ihre privateniCloudInhalt."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure no usa cuentas del desarrollador, analítica, publicidad ni seguimiento. El desarrollador no recibe el contenido de tu iCloud privado."
