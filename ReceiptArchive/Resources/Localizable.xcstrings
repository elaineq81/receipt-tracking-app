    "ReceiptSure does not operate a developer server and cannot browse your private iCloud database through the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSureلا يُشغّلُ خادمَ مطورَ ولا يَستطيعُ تَغْطاء خاصّتكiCloudقاعدة بيانات من خلال التطبيق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSurebetreibt keinen entwicklerserver und kann nicht in ihrem privaten surfen.iCloudDatenbank über die App."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure no utiliza un servidor del desarrollador ni puede consultar tu base de datos privada de iCloud desde la aplicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "ReceiptSure no utiliza un servidor del desarrollador ni puede consultar tu base de datos privada de iCloud desde la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSurene gère pas un serveur développeur et ne peut pas parcourir votre privéiCloudbase de données via l'application."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSurene gère pas un serveur développeur et ne peut pas parcourir votre privéiCloudbase de données via l'application."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSureלא להפעיל שרת מפתח ולא יכול לגלוש פרטי שלךiCloudמסד נתונים באמצעות האפליקציה"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSure開発者のサーバーを運営せず、プライベートの閲覧はできません。iCloudアプリを介したデータベース。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSure개발자 서버를 운영하지 않고 개인을 검색할 수 없습니다.iCloud앱을 통해 데이터베이스."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSurenão opera um servidor de desenvolvimento e não pode navegar pelo seu servidor privadoiCloudbase de dados através da aplicação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSurenão opera um servidor de desenvolvimento e não pode navegar pelo seu servidor privadoiCloudbase de dados através da aplicação."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ReceiptSureایک ترقی کار سرور کام نہیں کرتا اور اپنی نجی جانچ نہیں کر سکتاiCloudڈیٹا بیس ایپ کے ذریعے۔"
          }
        },
        "zh-Hans": {
