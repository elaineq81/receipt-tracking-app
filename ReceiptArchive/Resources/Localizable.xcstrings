    "Make sure every amount is visible. Adjust the four corners on any page before ReceiptSure reads it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تأكد من أن كل كمية مرئية عدل الزوايا الأربعة على أي صفحة قبلReceiptSureيقرأه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stellen Sie sicher, dass jeder Betrag sichtbar ist. Passen Sie die vier Ecken auf einer beliebigen Seite vorher anReceiptSureliest es."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que todos los importes sean visibles. Ajusta las cuatro esquinas de cada página antes de que ReceiptSure la lea."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que todos los montos sean visibles. Ajusta las cuatro esquinas de cada página antes de que ReceiptSure la lea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Assurez-vous que chaque montant est visible. Ajustez les quatre coins de n'importe quelle page avantReceiptSurelit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Assurez-vous que chaque montant est visible. Ajustez les quatre coins de n'importe quelle page avantReceiptSurelit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ודא שכל כמות נראית לעין. התאמת ארבע הפינות בכל דף לפניReceiptSureתקרא את זה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての金額が表示されることを確認してください。 どのページでも4つのコーナーを調節して下さいReceiptSure読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 금액이 표시됩니다. 전에 모든 페이지에 4개의 구석을 조정하십시오ReceiptSure그것을 읽으십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certifique-se de que cada quantidade é visível. Ajuste os quatro cantos em qualquer página antesReceiptSurelê."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
