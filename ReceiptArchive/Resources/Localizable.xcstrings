    "Payment is charged to your Apple Account. Purchases can be restored on devices using the same account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الدفع محمل على حساب التفاح الخاص بك. ويمكن إعادة شراء الأجهزة باستخدام نفس الحساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Zahlung wird Ihrem Apple-Konto belastet. Einkäufe können auf Geräten mit dem gleichen Konto wiederhergestellt werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga en tu cuenta de Apple. Puedes restaurar las compras en dispositivos que usen la misma cuenta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga en tu cuenta de Apple. Puedes restaurar las compras en dispositivos que usen la misma cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le paiement est facturé à votre compte Apple. Les achats peuvent être restaurés sur des appareils utilisant le même compte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le paiement est facturé à votre compte Apple. Les achats peuvent être restaurés sur des appareils utilisant le même compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "התשלום יחויב בחשבון Apple שלך. ניתן לשחזר רכישות על מכשירים באמצעות אותו חשבון."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "お支払いは、Appleアカウントに請求されます。 同一アカウントを使用して、デバイスで購入を復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "결제는 Apple 계정으로 청구됩니다. 구매는 동일한 계정을 사용하여 장치에 복원 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
