    "Used only when you choose to scan a receipt. VisionKit detects the document boundary and crops the image.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استعملت فقط عندما تختار فحص ايصال يكتشف (رؤية كيت) حدود الوثيقة و يزرع الصورة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird nur verwendet, wenn Sie eine Quittung scannen möchten. VisionKit erkennt die Dokumentgrenze und beschneidet das Bild."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa cuando decides escanear un recibo. VisionKit detecta los bordes del documento y recorta la imagen."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa cuando decides escanear un recibo. VisionKit detecta los bordes del documento y recorta la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisé seulement lorsque vous choisissez de scanner un reçu. VisionKit détecte la limite du document et cultive l'image."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisé seulement lorsque vous choisissez de scanner un reçu. VisionKit détecte la limite du document et cultive l'image."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בשימוש רק כאשר אתה בוחר לסרוק קבלה. VisionKit מזהה את גבול המסמך ומגייס את התמונה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "領収書をスキャンする場合のみ使用されます。 VisionKit は、ドキュメント境界を検出し、画像をクロップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "영수증을 스캔 할 때만 사용. VisionKit는 문서 경계를 감지하고 이미지를 작물합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usado apenas quando você escolhe digitalizar um recibo. VisionKit detecta o limite do documento e cultiva a imagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usado apenas quando você escolhe digitalizar um recibo. VisionKit detecta o limite do documento e cultiva a imagem."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صرف جب آپ کسی فائل کا انتخاب کریں تو استعمال کریں ۔ رویا کیت دستاویز کی حدود اور تصویر کی فصلوں کا پتہ دیتی ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只在选择扫描收据时使用. VisionKit检测文件边界,并裁剪图像."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
