    "Restore merges missing records and skips receipt IDs already on this device. It never deletes the current library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiederherstellen führt fehlende Datensätze zusammen und überspringt Quittungs-IDs, die bereits auf diesem Gerät vorhanden sind. Es löscht niemals die aktuelle Bibliothek."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurar fusiona los registros perdidos y salta los IDs de recibo ya en este dispositivo. Nunca elimina la biblioteca actual."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurar fusiona los registros perdidos y salta los IDs de recibo ya en este dispositivo. Nunca elimina la biblioteca actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurer fusionne les enregistrements manquants et saute les identifiants de réception déjà sur ce périphérique. Il ne supprime jamais la bibliothèque actuelle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurer fusionne les enregistrements manquants et saute les identifiants de réception déjà sur ce périphérique. Il ne supprime jamais la bibliothèque actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不足しているレコードをマージし、このデバイスに既にレシートIDをスキップします。 現在のライブラリは削除しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restore 병합 누락된 기록과 Skips 영수증 IDs 이미 이 장치. 현재 라이브러리를 삭제하지 마십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurar mescla registros faltando e ignora os IDs de recibo já neste dispositivo. Ele nunca apaga a biblioteca atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurar mescla registros faltando e ignora os IDs de recibo já neste dispositivo. Ele nunca apaga a biblioteca atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "恢复此设备上的缺失记录并跳过接收ID 。 它从不删除当前库."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "恢復此裝置上的缺失紀錄並跳過收件ID 。 它從不刪除目前的文庫 。"
          }
        }
      }
    },
    "Reuse trusted categories and filing details for merchants you visit regularly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwenden Sie vertrauenswürdige Kategorien und Dateidetails für Händler, die Sie regelmäßig besuchen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reutilizar categorías de confianza y presentar detalles para comerciantes que visita regularmente."
          }
        },
        "es-MX": {
