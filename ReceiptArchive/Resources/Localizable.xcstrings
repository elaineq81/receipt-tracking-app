    "The password is never stored. Keep it somewhere safe—an archive cannot be restored without it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Passwort wird niemals gespeichert. Bewahren Sie es an einem sicheren Ort auf - ein Archiv kann ohne es nicht wiederhergestellt werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La contraseña nunca se almacena. Mantenlo en algún lugar seguro: un archivo no puede ser restaurado sin él."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La contraseña nunca se almacena. Mantenlo en algún lugar seguro: un archivo no puede ser restaurado sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le mot de passe n'est jamais enregistré. Gardez-le en sécurité, une archive ne peut être restaurée sans elle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le mot de passe n'est jamais enregistré. Gardez-le en sécurité, une archive ne peut être restaurée sans elle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワードは保存されません。 安全に保管してください。アーカイブは復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "비밀번호는 저장되지 않습니다. 어딘가에 안전하게 보관할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A senha nunca é armazenada. Mantenha-o em algum lugar seguro – um arquivo não pode ser restaurado sem ele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A senha nunca é armazenada. Mantenha-o em algum lugar seguro – um arquivo não pode ser restaurado sem ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
