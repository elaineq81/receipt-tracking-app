    "The password is never stored. Keep it somewhere safe—an archive cannot be restored without it.": {
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La contraseña nunca se almacena. Mantenlo en algún lugar seguro: un archivo no puede ser restaurado sin él."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La contraseña nunca se almacena. Mantenlo en algún lugar seguro: un archivo no puede ser restaurado sin él."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密码从未存储 。 保存在安全的地方——没有它就无法恢复档案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密碼從未儲存 。 沒有它,"
          }
        }
      }
    },
    "The receipt image and audit history cannot be recovered after this action.": {
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La imagen de recepción y el historial de auditoría no pueden recuperarse después de esta acción."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La imagen de recepción y el historial de auditoría no pueden recuperarse después de esta acción."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此行动之后无法恢复收件图像和审计历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此動作之後, 收件影像與稽核歷史無法恢復 。"
          }
        }
      }
    },
    "The system file picker grants temporary access only to the image or PDF you select. Imported pages are stored inside the app’s private local database.": {
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El buscador de archivos del sistema otorga acceso temporal sólo a la imagen o PDF que seleccione. Las páginas importadas se almacenan dentro de la base de datos local privada de la aplicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El buscador de archivos del sistema otorga acceso temporal sólo a la imagen o PDF que seleccione. Las páginas importadas se almacenan dentro de la base de datos local privada de la aplicación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系统文件拾取器只允许临时访问图像或PDF你选择。 导入的页面存储在应用程序的本地私人数据库中 。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系統檔案拾取器只允許暫時存取影像或PDF你選擇。 匯入的頁面被儲存在應用程式的私人本地資料庫中。"
          }
        }
      }
    },
    "The system photo picker can import only the images you select; the app does not request broad photo library access.": {
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El selector de fotos del sistema puede importar sólo las imágenes que seleccione; la aplicación no solicita acceso amplio a la biblioteca de fotos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El selector de fotos del sistema puede importar sólo las imágenes que seleccione; la aplicación no solicita acceso amplio a la biblioteca de fotos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系统照片采集器只能导入您选择的图像; 应用程序不要求宽图片库访问 。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系統取照片者只可匯入您選取的影像; 應用程式不要求廣泛的相片庫存取 。"
