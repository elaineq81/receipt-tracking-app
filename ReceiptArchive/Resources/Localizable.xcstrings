    "Add a rule to suggest filing details when a merchant matches.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fügen Sie eine Regel hinzu, um die Einreichung von Details vorzuschlagen, wenn ein Händler übereinstimmt."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade una regla para sugerir detalles de presentación cuando un comerciante coincide."
