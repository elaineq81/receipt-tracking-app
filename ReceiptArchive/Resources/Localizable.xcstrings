    "The password is never stored. Keep it somewhere safe—an archive cannot be restored without it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كلمة السر لا تخزن أبداً أبقيه في مكان آمن لا يمكن إعادة المحفوظات بدونه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Passwort wird niemals gespeichert. Bewahren Sie es an einem sicheren Ort auf - ein Archiv kann ohne es nicht wiederhergestellt werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña nunca se guarda. Consérvala en un lugar seguro: sin ella no se puede restaurar el archivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña nunca se guarda. Consérvala en un lugar seguro: sin ella no se puede restaurar el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le mot de passe n'est jamais enregistré. Gardez-le en sécurité, une archive ne peut être restaurée sans elle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le mot de passe n'est jamais enregistré. Gardez-le en sécurité, une archive ne peut être restaurée sans elle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הסיסמה לעולם לא נשמרת. שמור על זה במקום בטוח - לא ניתן לשחזר ארכיון בלעדיו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワードは保存されません。 安全に保管してください。アーカイブは復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "비밀번호는 저장되지 않습니다. 어딘가에 안전하게 보관할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A senha nunca é armazenada. Mantenha-o em algum lugar seguro – um arquivo não pode ser restaurado sem ele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A senha nunca é armazenada. Mantenha-o em algum lugar seguro – um arquivo não pode ser restaurado sem ele."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "پاس ورڈ کبھی محفوظ نہیں ہے۔ اسے کسی جگہ محفوظ رکھیں. ایک محفوظ محفوظہ اس کے بغیر واپس نہیں کیا جا سکتا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密码从未存储 。 保存在安全的地方——没有它就无法恢复档案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密碼從未儲存 。 沒有它,"
          }
        }
      }
    },
    "The private iCloud copy was deleted. Your receipts remain on this iPhone.": {
      "localizations": {
