    "After a crop change, ReceiptSure reads all pages again. Check the refreshed values before saving.": {
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Después de un cambio de cultivo, ReceiptSure lee todas las páginas de nuevo. Revise los valores refrescados antes de guardar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Después de un cambio de cultivo, ReceiptSure lee todas las páginas de nuevo. Revise los valores refrescados antes de guardar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "作物改变后ReceiptSure再读所有页面。 保存前检查刷新值 。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "作物改變後ReceiptSure重新讀取所有頁面。 保存前檢查已刷新值 。"
          }
        }
      }
    },
