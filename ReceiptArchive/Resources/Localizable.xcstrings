    "After a crop change, ReceiptSure reads all pages again. Check the refreshed values before saving.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بعد تغيير المحاصيلReceiptSureيقرأ كل الصفحات مرة أخرى. تحقق من القيم المستعادة قبل الادخار"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nach einem Erntewechsel,ReceiptSureLies alle Seiten noch einmal. Überprüfen Sie die aktualisierten Werte vor dem Speichern."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras cambiar el recorte, ReceiptSure vuelve a leer todas las páginas. Revisa los valores actualizados antes de guardar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cambiar el recorte, ReceiptSure vuelve a leer todas las páginas. Revisa los valores actualizados antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Après un changement de culture,ReceiptSurelit toutes les pages à nouveau. Vérifiez les valeurs actualisées avant d'enregistrer."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Après un changement de culture,ReceiptSurelit toutes les pages à nouveau. Vérifiez les valeurs actualisées avant d'enregistrer."
          }
        },
        "he": {
          "stringUnit": {
