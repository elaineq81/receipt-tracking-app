    "Deleting a category removes it from future pickers. Existing receipts keep their category name for accurate historical reports.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Löschen einer Kategorie entfernt sie von zukünftigen Pickern. Bestehende Quittungen behalten ihren Kategorienamen für genaue historische Berichte bei."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminar una categoría lo elimina de futuros recicladores. Los recibos existentes mantienen su nombre de categoría para informes históricos precisos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminar una categoría lo elimina de futuros recicladores. Los recibos existentes mantienen su nombre de categoría para informes históricos precisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprimer une catégorie l'enlève aux futurs récupérateurs. Les reçus existants conservent leur nom de catégorie pour des rapports historiques exacts."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprimer une catégorie l'enlève aux futurs récupérateurs. Les reçus existants conservent leur nom de catégorie pour des rapports historiques exacts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カテゴリを削除して、将来のピッカーから削除します。 既存のレシートは、正確な履歴レポートのカテゴリ名を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "범주 삭제는 미래의 픽업에서 제거. Existing 영수증은 정확한 역사적인 보고서에 대한 범주 이름을 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Excluir uma categoria remove-a dos futuros catadores. Os recibos existentes mantêm seu nome de categoria para relatórios históricos precisos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Excluir uma categoria remove-a dos futuros catadores. Os recibos existentes mantêm seu nome de categoria para relatórios históricos precisos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除一个分类将它从未来的拾取者中删除. 现有收据为准确的历史报告保留其类别名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "刪除類別將它從未來的選取者中移除 。 現有收據都保留其類別名號 以做准确的歷史報告"
          }
        }
      }
    },
