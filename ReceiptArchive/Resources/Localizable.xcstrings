    "A different device with private sync still enabled may upload its library again. Local receipts will not be deleted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جهاز مختلف مع مزامنة خاصة ما زال مُمكّن من تحميل مكتبته مرة أخرى. ولن تحذف الإيصالات المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein anderes Gerät mit noch aktivierter privater Synchronisierung kann seine Bibliothek erneut hochladen. Lokale Quittungen werden nicht gelöscht."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo que aún tenga activada la sincronización privada puede volver a subir su biblioteca. Los recibos locales no se eliminarán."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo que aún tenga activada la sincronización privada puede volver a subir su biblioteca. Los recibos locales no se eliminarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un appareil différent avec synchronisation privée encore activé peut télécharger sa bibliothèque à nouveau. Les reçus locaux ne seront pas supprimés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un appareil différent avec synchronisation privée encore activé peut télécharger sa bibliothèque à nouveau. Les reçus locaux ne seront pas supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מכשיר אחר עם סינכרון פרטי עדיין אפשר להעלות את הספריה שוב. קבלות מקומיות לא יימחקו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プライベート同期の異なるデバイスは、ライブラリを再びアップロードできます。 ローカルレシートは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "개인 동기화가 가능한 다른 장치는 라이브러리를 다시 업로드 할 수 있습니다. 로컬 영수증은 삭제되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um dispositivo diferente com sincronização privada ainda habilitado pode enviar sua biblioteca novamente. Os recibos locais não serão apagados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um dispositivo diferente com sincronização privada ainda habilitado pode enviar sua biblioteca novamente. Os recibos locais não serão apagados."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نجی سنک کے ساتھ ایک مختلف اوزار اپنی لائبریری دوبارہ لوڈ کرنے کے قابل ہو سکتا ہے ۔ مقامی باشندوں کو ختم نہیں کیا جائے گا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台仍启用专用同步的设备可能会再次上传其资料库。本地收据不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍然啟用私有同步的另一個裝置可能會再次上傳其文庫 。 本地收據不會被刪除 。"
          }
        }
      }
    },
    "A receipt with the same merchant, date, currency, and total is already saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وقد تم بالفعل توفير إيصال مع نفس التاجر وتاريخه وعملته ومجموعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Quittung mit dem gleichen Händler, Datum, Währung und Gesamt wird bereits gespeichert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay guardado un recibo con el mismo comercio, fecha, moneda y total."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay guardado un recibo con el mismo comercio, fecha, moneda y total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un reçu avec le même marchand, date, monnaie et total est déjà enregistré."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un reçu avec le même marchand, date, monnaie et total est déjà enregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "קבלה עם אותו סוחר, תאריך, מטבע, והכל כבר נשמר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同じ商人、日付、通貨、合計の領収書は既に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "동일한 상인, 날짜, 통화 및 합계를 가진 영수증은 이미 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um recibo com o mesmo comerciante, data, moeda e total já está salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um recibo com o mesmo comerciante, data, moeda e total já está salvo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اِسی تاجر ، تاریخ ، چاندی اور کُل‌وقتی طور پر محفوظ ہے ۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同商的收据,日期,货币和总额已经保存."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同樣的商家的收據 日期 貨幣 總和已經存了"
          }
        }
      }
    },
