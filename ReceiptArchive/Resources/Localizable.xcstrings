    "Secure archives are encrypted locally with AES-GCM and a password-derived key. The password is never stored or uploaded, and restore only adds missing records.": {
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los archivos seguros se cifran localmente con AES-GCM y una clave con contraseña. La contraseña nunca se almacena o se carga, y restaurar sólo añade los registros perdidos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los archivos seguros se cifran localmente con AES-GCM y una clave con contraseña. La contraseña nunca se almacena o se carga, y restaurar sólo añade los registros perdidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "安全档案在本地加密AES-GCM和密码生成的密钥。 密码从不存储或上传,只恢复添加缺失的记录."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "安全檔案在本地加密AES-GCM和密碼產生的金鑰。 密碼從未儲存或上傳, 只恢复新增缺失的紀錄 。"
          }
        }
      }
    },
