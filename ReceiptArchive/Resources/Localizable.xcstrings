    "Payment is charged to your Apple Account. Purchases can be restored on devices using the same account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Zahlung wird Ihrem Apple-Konto belastet. Einkäufe können auf Geräten mit dem gleichen Konto wiederhergestellt werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El pago se carga a su cuenta de Apple. Las compras pueden ser restauradas en dispositivos usando la misma cuenta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El pago se carga a su cuenta de Apple. Las compras pueden ser restauradas en dispositivos usando la misma cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le paiement est facturé à votre compte Apple. Les achats peuvent être restaurés sur des appareils utilisant le même compte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le paiement est facturé à votre compte Apple. Les achats peuvent être restaurés sur des appareils utilisant le même compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "お支払いは、Appleアカウントに請求されます。 同一アカウントを使用して、デバイスで購入を復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "결제는 Apple 계정으로 청구됩니다. 구매는 동일한 계정을 사용하여 장치에 복원 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O pagamento é cobrado na sua Conta Apple. As compras podem ser restauradas em dispositivos usando a mesma conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O pagamento é cobrado na sua Conta Apple. As compras podem ser restauradas em dispositivos usando a mesma conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "付款由你的苹果账户支付。 用同一账户的设备可以恢复购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "付款记入你的蘋果帳戶 使用同一帳戶的裝置可以恢复買入。"
          }
        }
      }
