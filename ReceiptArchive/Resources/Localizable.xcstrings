    "Apply its category and filing suggestions, then review them before saving.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تطبيق فئتها وتقديم الاقتراحات، ثم استعراضها قبل الادخار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenden Sie die Kategorie an und reichen Sie Vorschläge ein, dann überprüfen Sie sie, bevor Sie speichern."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica sus sugerencias de categoría y clasificación y revísalas antes de guardar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica sus sugerencias de categoría y clasificación y revísalas antes de guardar."
          }
        },
        "fr": {
