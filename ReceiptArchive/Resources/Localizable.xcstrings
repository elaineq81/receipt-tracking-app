    "Restore merges missing records and skips receipt IDs already on this device. It never deletes the current library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعيدون تسجيلات مفقودة ويفوتون بطاقات إستلام على هذا الجهاز انها لا تحذف المكتبة الحالية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiederherstellen führt fehlende Datensätze zusammen und überspringt Quittungs-IDs, die bereits auf diesem Gerät vorhanden sind. Es löscht niemals die aktuelle Bibliothek."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración incorpora los registros que faltan y omite los identificadores de recibos que ya estén en este dispositivo. Nunca elimina la biblioteca actual."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración incorpora los registros que faltan y omite los identificadores de recibos que ya estén en este dispositivo. Nunca elimina la biblioteca actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurer fusionne les enregistrements manquants et saute les identifiants de réception déjà sur ce périphérique. Il ne supprime jamais la bibliothèque actuelle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurer fusionne les enregistrements manquants et saute les identifiants de réception déjà sur ce périphérique. Il ne supprime jamais la bibliothèque actuelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שחזור ממזג רשומות חסרות ומלג על תעודות קבלה כבר במכשיר זה. היא מעולם לא מחקה את הספרייה הנוכחית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不足しているレコードをマージし、このデバイスに既にレシートIDをスキップします。 現在のライブラリは削除しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restore 병합 누락된 기록과 Skips 영수증 IDs 이미 이 장치. 현재 라이브러리를 삭제하지 마십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurar mescla registros faltando e ignora os IDs de recibo já neste dispositivo. Ele nunca apaga a biblioteca atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurar mescla registros faltando e ignora os IDs de recibo já neste dispositivo. Ele nunca apaga a biblioteca atual."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس ڈیوائس پر پہلے سے ہی گم شدہ ریکارڈز اور کرایہ شناختی آئی ڈی کو ملا دیتا ہے۔ یہ کبھی موجودہ لائبریری کو حذف نہیں کرتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "恢复此设备上的缺失记录并跳过接收ID 。 它从不删除当前库."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "恢復此裝置上的缺失紀錄並跳過收件ID 。 它從不刪除目前的文庫 。"
          }
        }
      }
    },
    "Reuse trusted categories and filing details for merchants you visit regularly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
