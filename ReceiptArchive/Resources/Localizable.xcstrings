    "Secure archives are encrypted locally with AES-GCM and a password-derived key. The password is never stored or uploaded, and restore only adds missing records.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المحفوظات المضمونة مشفرة محلياAES-GCMومفتاح مستمد من كلمة السر كلمة السر لا تخزن أو تُحمّل أبداً و تُعيد فقط السجلات المفقودة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sichere Archive werden lokal mitAES-GCMund einem passwortbasierten Schlüssel. Das Passwort wird niemals gespeichert oder hochgeladen, und die Wiederherstellung fügt nur fehlende Datensätze hinzu."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos seguros se cifran localmente con AES-GCM y una clave derivada de la contraseña. La contraseña nunca se guarda ni se sube, y la restauración solo añade los registros que faltan."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos seguros se cifran localmente con AES-GCM y una clave derivada de la contraseña. La contraseña nunca se guarda ni se sube, y la restauración solo agrega los registros que faltan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les archives sécurisées sont cryptées localement avecAES-GCMet une clé dérivée par mot de passe. Le mot de passe n'est jamais stocké ou téléchargé et ne restaure que les enregistrements manquants."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les archives sécurisées sont cryptées localement avecAES-GCMet une clé dérivée par mot de passe. Le mot de passe n'est jamais stocké ou téléchargé et ne restaure que les enregistrements manquants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ארכיונים מאובטחים מוצפנים באופן מקומיAES-GCMמפתח סיסמה. הסיסמה לעולם אינה מאוחסנת או מועלתה, והחזרה רק מוסיפה רשומות חסרות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "安全なアーカイブは、ローカルで暗号化されますAES-GCMパスワード対応キー パスワードは保存されず、アップロードされず、紛失したレコードのみを復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "안전한 아카이브는 로컬로 암호화됩니다.AES-GCM비밀번호 필수 비밀번호가 저장되거나 업로드되지 않으며, 누락된 레코드만 복구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arquivos seguros são criptografados localmente comAES-GCMe uma chave derivada da senha. A senha nunca é armazenada ou enviada, e a restauração só adiciona registros ausentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arquivos seguros são criptografados localmente comAES-GCMe uma chave derivada da senha. A senha nunca é armazenada ou enviada, e a restauração só adiciona registros ausentes."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حفاظتی محفوظات کو مقامی طور پر زیر کیا گیا ہے۔AES-GCMاور پاس ورڈ د کھائیں پاس ورڈ کبھی محفوظ یا اپلوڈ نہیں کیا جاتا اور صرف گمشدہ ریکارڈ بحال کر دیتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "安全档案在本地加密AES-GCM和密码生成的密钥。 密码从不存储或上传,只恢复添加缺失的记录."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "安全檔案在本地加密AES-GCM和密碼產生的金鑰。 密碼從未儲存或上傳, 只恢复新增缺失的紀錄 。"
          }
        }
      }
    },
