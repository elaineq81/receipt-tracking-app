    "Unlimited receipts, matters, reports, and merchant rules are unlocked on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الإيصالات غير المحدودة، والمسائل، والتقارير، وقواعد التجار مفتوحة على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unbegrenzte Quittungen, Angelegenheiten, Berichte und Händlerregeln werden auf diesem Gerät freigeschaltet."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "En este dispositivo están desbloqueados los recibos, asuntos, informes y reglas de comercios ilimitados."
