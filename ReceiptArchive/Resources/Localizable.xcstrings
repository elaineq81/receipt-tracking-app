    "Used only when you choose to scan a receipt. VisionKit detects the document boundary and crops the image.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird nur verwendet, wenn Sie eine Quittung scannen möchten. VisionKit erkennt die Dokumentgrenze und beschneidet das Bild."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
