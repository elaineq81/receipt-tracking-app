        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSVist immer frei. Dein ersterPDFBericht ist enthalten; unbegrenztPDF,Excel,Word,JPG, und überprüfbare Proof Pack Exporte sind mit Pro verfügbar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV siempre es gratis. Se incluye tu primer informe PDF; con Pro dispones de exportaciones ilimitadas a PDF, Excel, Word y JPG, además de paquetes de pruebas verificables."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV siempre es gratis. Se incluye tu primer informe PDF; con Pro tienes exportaciones ilimitadas a PDF, Excel, Word y JPG, además de paquetes de pruebas verificables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSVest toujours libre. Votre premierPDFrapport est inclus; illimitéPDF,Excel,Word,JPG, et les exportations de Proof Pack vérifiables sont disponibles avec Pro."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSVest toujours libre. Votre premierPDFrapport est inclus; illimitéPDF,Excel,Word,JPG, et les exportations de Proof Pack vérifiables sont disponibles avec Pro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSVתמיד חופשי. הראשון שלךPDFדו\"ח נכלל; בלתי מוגבלPDF,Excel,Word,JPG, ויצוא חבילת הוכחת אימות זמינים עם Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV常に無料です。 初めての方へPDF報告は含まれます;無制限PDF,Excel,Word,JPG、および検証可能な証拠のパックの輸出はプロと利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV항상 무료입니다. 첫 번째PDF보고서 포함; 무제한PDF·Excel·Word·JPG, 그리고 verifiable 증거 팩 수출은 직업으로 유효합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSVé sempre livre. O teu primeiroPDFrelatório está incluído; ilimitadoPDF,Excel,Word,JPG, e as exportações verificáveis do pacote de prova estão disponíveis com Pro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSVé sempre livre. O teu primeiroPDFrelatório está incluído; ilimitadoPDF,Excel,Word,JPG, e as exportações verificáveis do pacote de prova estão disponíveis com Pro."
          }
        },
        "ur": {
