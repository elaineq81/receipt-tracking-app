    "Confidence describes text recognition quality, not whether an expense is valid.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وتصف الثقة جودة الاعتراف بالنص، وليس ما إذا كانت النفقات صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertrauen beschreibt Texterkennungsqualität, nicht ob eine Ausgabe gültig ist."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La confianza indica la calidad del reconocimiento de texto, no si un gasto es válido."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La confianza indica la calidad del reconocimiento de texto, no si un gasto es válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La confiance décrit la qualité de la reconnaissance textuelle, et non la validité d'une dépense."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La confiance décrit la qualité de la reconnaissance textuelle, et non la validité d'une dépense."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אמון מתאר איכות זיהוי טקסט, לא אם עלות תקפה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "機密性は、費用が有効かどうかではなく、テキスト認識の品質を記述します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confidence는 텍스트 인식 품질을 설명합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confiança descreve qualidade de reconhecimento de texto, não se uma despesa é válida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confiança descreve qualidade de reconhecimento de texto, não se uma despesa é válida."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اعتماد کی بات ہے کہ اگر کوئی شخص خرچ کرنا مناسب نہیں تو اُسے کیا کرنا چاہئے ۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "信任是指文本识别的质量,而不是费用是否有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "信任描述的是文本認證的質量, 而不是成本是否合法 。"
          }
        }
      }
    },
