    "Renaming updates existing receipts and merchant rules that use this custom category, preserving consistent reports.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Umbenennung aktualisiert bestehende Quittungen und Händlerregeln, die diese benutzerdefinierte Kategorie verwenden, und bewahrt konsistente Berichte."
          }
        },
        "es-ES": {
          "stringUnit": {
