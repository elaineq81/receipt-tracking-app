    "Drag each corner to the edge of the receipt. The result will be straightened before text is read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehen Sie jede Ecke an den Rand der Quittung. Das Ergebnis wird begradigt, bevor der Text gelesen wird."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrastre cada esquina al borde del recibo. El resultado será enderezado antes de leer el texto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrastre cada esquina al borde del recibo. El resultado será enderezado antes de leer el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser chaque coin vers le bord du reçu. Le résultat sera rectifié avant que le texte ne soit lu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser chaque coin vers le bord du reçu. Le résultat sera rectifié avant que le texte ne soit lu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各コーナーをレシートの端にドラッグします。 テキストが読み込まれる前に結果がまっすぐになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "영수증의 가장자리에 각 구석을 드래그하십시오. 결과 텍스트가 읽기 전에 단축됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste cada canto para a borda do recibo. O resultado será endireitado antes da leitura do texto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste cada canto para a borda do recibo. O resultado será endireitado antes da leitura do texto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将每个角拖到收据的边缘. 在读出文本之前,结果将会得到纠正。"
          }
        },
        "zh-Hant": {
