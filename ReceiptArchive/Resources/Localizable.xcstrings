    "Always compare extracted totals with the original receipt before relying on a report for accounting or tax purposes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دائماً ما يقارن المجاميع المستخرجة مع الإيصال الأصلي قبل الاعتماد على تقرير لأغراض المحاسبة أو الضرائب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vergleichen Sie immer extrahierte Summen mit der ursprünglichen Quittung, bevor Sie sich auf einen Bericht für Buchhaltungs- oder Steuerzwecke verlassen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara siempre los totales extraídos con el recibo original antes de utilizar un informe con fines contables o fiscales."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara siempre los totales extraídos con el recibo original antes de utilizar un informe con fines contables o fiscales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comparez toujours les totaux extraits avec le reçu original avant de vous fier à une déclaration à des fins comptables ou fiscales."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comparez toujours les totaux extraits avec le reçu original avant de vous fier à une déclaration à des fins comptables ou fiscales."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תמיד להשוות סךים מופקים עם הקבלה המקורית לפני להסתמך על דו\"ח למטרות חשבונאות או מס."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "会計または税務目的のためにレポートに依存する前に、元の領収書と抽出された合計を常に比較します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "항상 표백 또는 세금 목적으로 보고서에 의존하기 전에 원래 영수증을 가진 총을 비교합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre comparar os totais extraídos com o recibo original antes de contar com um relatório para fins contabilísticos ou fiscais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre comparar os totais extraídos com o recibo original antes de contar com um relatório para fins contabilísticos ou fiscais."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حساب‌کتاب یا ٹیکس کے مقاصد کے لئے رپورٹ پر بھروسا کرنے سے پہلے تمام اجزا کا موازنہ کریں ۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在将报告用于会计或税务用途之前，请务必将提取的总额与原始收据进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將報告用於會計或稅務用途之前，請務必將擷取的總額與原始收據進行比較。"
          }
        }
      }
    },
