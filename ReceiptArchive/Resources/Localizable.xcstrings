    "Transport" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Transporte" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "交通" } } } },
    "Edit category" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Editar categoría" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "编辑类别" } } } },
    "Encryption key synced by iCloud Keychain" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Clave de cifrado sincronizada mediante el Llavero de iCloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "加密密钥通过 iCloud 钥匙串同步" } } } },
    "Last successful sync" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Última sincronización correcta" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上次成功同步" } } } },
    "Merchant rules" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Reglas de comercios" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "商户规则" } } } },
    "Name" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Nombre" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "名称" } } } },
    "No custom categories" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay categorías personalizadas" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有自定义类别" } } } },
    "Not synced yet" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Aún no se ha sincronizado" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未同步" } } } },
    "Private CloudKit database" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Base de datos privada de CloudKit" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专用 CloudKit 数据库" } } } },
    "Private iCloud sync" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sincronización privada con iCloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专用 iCloud 同步" } } } },
    "Private sync" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sincronización privada" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专用同步" } } } },
    "Privacy summary" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Resumen de privacidad" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐私摘要" } } } },
    "Receipt images and expense details stay local unless you explicitly enable private iCloud sync." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Las imágenes de recibos y los detalles de gastos permanecen en el dispositivo salvo que actives expresamente la sincronización privada con iCloud." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "除非你明确启用专用 iCloud 同步，否则收据图像和支出详情只保存在本机。" } } } },
    "ReceiptSure does not operate a developer server and cannot browse your private iCloud database through the app." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "ReceiptSure no utiliza un servidor del desarrollador ni puede consultar tu base de datos privada de iCloud desde la aplicación." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "ReceiptSure 不运行开发者服务器，也无法通过应用浏览你的专用 iCloud 数据库。" } } } },
    "Stored on this device" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Guardado en este dispositivo" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "存储在此设备上" } } } },
    "Symbol" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Símbolo" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "图标" } } } },
    "Sync with private iCloud" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sincronizar con iCloud privado" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同步到专用 iCloud" } } } },
    "Syncing…" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sincronizando…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在同步…" } } } },
    "Unlock" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Desbloquear" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "解锁" } } } },
    "When enabled, ReceiptSure uploads an encrypted library snapshot—including receipt images—to your private iCloud database. It is available only to devices signed in to your Apple Account. Sync merges records and honors permanent-deletion markers." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Al activarla, ReceiptSure sube una copia cifrada de la biblioteca, incluidas las imágenes de recibos, a tu base de datos privada de iCloud. Solo está disponible para los dispositivos conectados a tu cuenta de Apple. La sincronización combina registros y respeta los marcadores de eliminación permanente." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用后，ReceiptSure 会将包含收据图像的加密资料库快照上传到你的专用 iCloud 数据库。只有登录你 Apple 账户的设备可以使用。同步会合并记录并遵循永久删除标记。" } } } },
    "Your private iCloud library is up to date." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu biblioteca privada de iCloud está actualizada." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的专用 iCloud 资料库已是最新状态。" } } } },
    "iCloud sync couldn’t finish" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo completar la sincronización con iCloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法完成 iCloud 同步" } } } },
    "Sync now" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sincronizar ahora" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "立即同步" } } } },
    "Delete iCloud copy" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Eliminar copia de iCloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除 iCloud 副本" } } } },
    "This removes only ReceiptSure’s encrypted snapshot from your private iCloud database. Receipts on this iPhone remain." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Esto solo elimina la copia cifrada de ReceiptSure de tu base de datos privada de iCloud. Los recibos permanecen en este iPhone." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这只会从你的专用 iCloud 数据库中移除 ReceiptSure 的加密快照。此 iPhone 上的收据会保留。" } } } },
    "Delete private iCloud copy?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Eliminar la copia privada de iCloud?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除专用 iCloud 副本？" } } } },
    "Delete Cloud Copy" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Eliminar copia en la nube" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除云端副本" } } } },
    "Keep Copy" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Conservar copia" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保留副本" } } } },
    "A different device with private sync still enabled may upload its library again. Local receipts will not be deleted." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Otro dispositivo que aún tenga activada la sincronización privada puede volver a subir su biblioteca. Los recibos locales no se eliminarán." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "另一台仍启用专用同步的设备可能会再次上传其资料库。本地收据不会被删除。" } } } },
    "The private iCloud copy was deleted. Your receipts remain on this iPhone." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se eliminó la copia privada de iCloud. Tus recibos permanecen en este iPhone." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专用 iCloud 副本已删除。你的收据仍保留在此 iPhone 上。" } } } }
  },
  "version" : "1.0"
}
